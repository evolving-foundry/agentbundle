{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": ".build",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true,
    "paths": {},
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests", ".build", "dist", "node_modules"]
}
